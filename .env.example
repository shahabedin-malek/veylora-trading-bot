# Local SQLite URL for Prisma when the database phase is implemented.
DATABASE_URL="file:./dev.db"

# Public app origin used to bind SIWE messages; production must use HTTPS.
APP_BASE_URL="http://localhost:3000"

# Comma-separated EVM mainnet chain IDs approved for wallet authentication.
# Leave empty until the user separately approves an authentication chain.
AUTH_EVM_CHAIN_IDS=""

# Phase 4 session signing secret; generate a unique value of at least 32 random bytes.
SESSION_SECRET="replace-with-a-unique-random-secret-of-at-least-32-bytes"