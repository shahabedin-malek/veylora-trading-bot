{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    ".next-market-check/types/**/*.ts",
    ".next-market-check/dev/types/**/*.ts",
    ".next-wallet-admin-preview/types/**/*.ts",
    ".next-wallet-admin-preview/dev/types/**/*.ts",
    ".next/dev-phase06/types/**/*.ts",
    ".next/dev-phase06/dev/types/**/*.ts",
    ".next-phase07/types/**/*.ts",
    ".next-phase07/dev/types/**/*.ts",
    ".next-phase07-unconfigured/types/**/*.ts",
    ".next-phase07-unconfigured/dev/types/**/*.ts",
    ".next-phase07-click/types/**/*.ts",
    ".next-phase07-click/dev/types/**/*.ts",
    ".next/dev-phase09/types/**/*.ts",
    ".next/dev-phase09/dev/types/**/*.ts",
    ".next/dev-phase10/types/**/*.ts",
    ".next/dev-phase10/dev/types/**/*.ts",
    ".next/dev-phase12/types/**/*.ts",
    ".next/dev-phase12/dev/types/**/*.ts",
    ".next-phase13/types/**/*.ts",
    ".next-phase13/dev/types/**/*.ts",
    ".next-phase14/types/**/*.ts",
    ".next-phase14/dev/types/**/*.ts",
    ".next-phase14-plain/types/**/*.ts",
    ".next-phase14-plain/dev/types/**/*.ts",
    ".next-phase15/types/**/*.ts",
    ".next-phase15/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
