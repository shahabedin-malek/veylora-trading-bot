# ---------------------------------------------------------------------------
# Alchemy RPC keys (all 157 networks are enabled on this app key)
#
# Source of truth: /home/chris/env/alchemy.env (converted from the Alchemy
# dashboard export /home/chris/env/alchemy.txt).
#
# This file is a CHECKED-IN example and must never hold a real key. The real
# value lives in the `pass` entry ai/alchemy-api-key (local) and in the Vercel
# project env vars (per environment, type Secret).
#
# The key is account-wide, so ALCHEMY_ETHEREUM_MAINNET_API_KEY alone works on
# every network. The *_RPC_URL vars exist so app code can select a network
# without string-building; replace <ALCHEMY_KEY> with the real key.
# ---------------------------------------------------------------------------
ALCHEMY_APP_ID="450g7uniyp7n7qbk"
ALCHEMY_ETHEREUM_MAINNET_RPC_URL="https://eth-mainnet.g.alchemy.com/v2/<ALCHEMY_KEY>"
ALCHEMY_ETHEREUM_SEPOLIA_RPC_URL="https://eth-sepolia.g.alchemy.com/v2/<ALCHEMY_KEY>"
ALCHEMY_BASE_MAINNET_RPC_URL="https://base-mainnet.g.alchemy.com/v2/<ALCHEMY_KEY>"
ALCHEMY_BASE_SEPOLIA_RPC_URL="https://base-sepolia.g.alchemy.com/v2/<ALCHEMY_KEY>"
ALCHEMY_ARBITRUM_MAINNET_RPC_URL="https://arb-mainnet.g.alchemy.com/v2/<ALCHEMY_KEY>"
ALCHEMY_ARBITRUM_SEPOLIA_RPC_URL="https://arb-sepolia.g.alchemy.com/v2/<ALCHEMY_KEY>"
ALCHEMY_POLYGON_MAINNET_RPC_URL="https://polygon-mainnet.g.alchemy.com/v2/<ALCHEMY_KEY>"
ALCHEMY_OPT_MAINNET_RPC_URL="https://opt-mainnet.g.alchemy.com/v2/<ALCHEMY_KEY>"
ALCHEMY_SOLANA_MAINNET_RPC_URL="https://solana-mainnet.g.alchemy.com/v2/<ALCHEMY_KEY>"
# ... 157 networks total; the complete list is in /home/chris/env/alchemy.env
