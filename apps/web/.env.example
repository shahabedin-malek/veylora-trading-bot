# Template for `apps/web/.env` (and the per-environment values on the host).
#
# Every name this application reads is listed here, in the environment it belongs
# to. Names only: real values never belong in a checked-in file, and the values
# below are deliberately non-functional placeholders so a half-configured copy
# reads as "not configured" instead of looking ready.
#
# Local development needs almost none of this. `pnpm db:setup` creates a SQLite
# file at apps/web/prisma/dev.db and seeds it; the application then runs with
# those defaults and no secrets at all. See README.md.

# ---------------------------------------------------------------------------
# Datasource
# ---------------------------------------------------------------------------

# Development default: the local SQLite file. `pnpm db:setup`, `db:reset` and
# `db:seed` refuse any other value, and they refuse a non-local value in this
# file too, so the running app cannot read a database the scripts did not seed.
# Production sets this to the pooled Neon URL.
DATABASE_URL="file:./dev.db"

# Production only: the direct (unpooled) Neon URL. Development never reads it.
DATABASE_URL_UNPOOLED=""

# Neon-style aliases. Only consulted when the standard name above is empty.
# veylora_DATABASE_URL=""
# veylora_DATABASE_URL_UNPOOLED=""

# ---------------------------------------------------------------------------
# Wallet sign-in and sessions
# ---------------------------------------------------------------------------

# Origin SIWE messages are bound to. Production must be HTTPS.
APP_BASE_URL="http://localhost:3000"

# Comma-separated EVM chain ids approved for wallet authentication. Empty means
# sign-in is closed.
AUTH_EVM_CHAIN_IDS=""

# Wallet that receives the OWNER role on first sign-in, and the wallet the local
# seed assigns OWNER to. Development (NODE_ENV=development) falls back to the
# shared constant DEVELOPMENT_OWNER_EVM_ADDRESS, so a local database seeded with
# nothing configured and a sign-in as that address agree about who the owner is.
# Any other mode grants nobody OWNER when this is unset.
INITIAL_ADMIN_EVM_ADDRESS="replace-with-the-owner-evm-wallet-address"

# Session cookie signing secret: at least 32 random bytes.
SESSION_SECRET="replace-with-a-unique-random-secret-of-at-least-32-bytes"

# 64 hex characters that encrypt venue API keys at rest, and — with a purpose-specific AAD —
# the TOTP secret, inbound signal secrets and outbound webhook secrets (phases 10 and 31).
TRADING_CREDENTIAL_ENCRYPTION_KEY="replace-with-64-hex-characters-from-a-cryptographically-secure-random-generator"

# ---------------------------------------------------------------------------
# Public browser configuration
# ---------------------------------------------------------------------------

# Project id for mobile wallet pairing, from the Reown (formerly WalletConnect)
# dashboard. Read first, by resolveWalletConnectProjectId in
# src/lib/auth/wallet-connect.ts, and used by /login, /admin/access readiness and
# the development environment checklist. Public by definition (it ends up in the
# browser bundle); never put a secret here. Unset, /login names this variable
# instead of showing a QR, and injected wallets keep working.
NEXT_PUBLIC_REOWN_PROJECT_ID=""

# The pre-rebrand name for the same project id, read only when the Reown name
# above is unset. Setting both is not an error; the Reown one wins.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=""

# ---------------------------------------------------------------------------
# Scheduled work
# ---------------------------------------------------------------------------

# Shared secret the market-alert cron route requires.
CRON_SECRET=""

# Minutes between market-alert evaluations. Defaults to 1440.
MARKET_ALERT_EVALUATION_INTERVAL_MINUTES="1440"

# ---------------------------------------------------------------------------
# Alert delivery (phase 29)
# ---------------------------------------------------------------------------

# Email is sent through Resend's HTTP API (one POST, no SDK). All three values are
# required for the email channel to send. A missing one is named in the panel and in
# the delivery log, and the other channels keep working. The account has no email
# column by design — accounts are wallets — so ALERT_EMAIL_TO is the owner's own
# address, not a per-user value.
RESEND_API_KEY=""
ALERT_EMAIL_FROM=""
ALERT_EMAIL_TO=""
# Optional, for a local stand-in that proves a failure and its retries without a real
# key. Unset means https://api.resend.com.
RESEND_API_BASE_URL=""

# Telegram Bot API. Both are required for the Telegram channel. The bot token is
# redacted from every error and log line this app writes; it is never rendered.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
# Optional, for a local stand-in. Unset means https://api.telegram.org.
TELEGRAM_API_BASE_URL=""

# Shortest gap at which the order-reconciliation job claims to be due. Accepts 1,
# 5, 15, 30, 60, 360 or 1440; anything else falls back to 5. The host's own cron
# cadence is the real ceiling, so on a once-a-day schedule this only stops the job
# from claiming due-ness twice in the same minute. Defaults to 5.
ORDER_RECONCILE_INTERVAL_MINUTES="5"

# ---------------------------------------------------------------------------
# Paper venue
# ---------------------------------------------------------------------------
# Until phase 21 wires a real venue, the paper venue is the venue every order
# reaches in every environment — and it moves no money, which is why the order
# rows are labelled PAPER. Neither name below can point an order at an exchange.
#
# PAPER_VENUE_FAILURE=unavailable|timeout|rejected makes every submission take that
# path, which is how the failure branch is exercised by hand; empty means the venue
# answers. This one is read **only** where NODE_ENV is exactly development, so a
# deployment cannot be left failing orders by accident.
PAPER_VENUE_FAILURE=""

# Seconds a market order takes to fill, in two steps of half each. Defaults to 5.
# 0 fills at submission, which is what a hand-run click-path wants. Read wherever
# the paper venue runs, since the venue itself is not environment-gated.
PAPER_VENUE_FILL_DELAY_SECONDS="5"

# ---------------------------------------------------------------------------
# Assistant model gateway
# ---------------------------------------------------------------------------

AI_GATEWAY_API_KEY=""
AI_GATEWAY_MODEL=""
# Ordered fallback target for the default route. Optional; the admin panel can name a
# different order without a redeploy.
AI_GATEWAY_FALLBACK_MODEL=""
# Prices for the per-request meter, in dollars per million tokens. Both are optional and
# have no default: with neither set a request's cost is recorded as unpriced (null) and
# the panel says so, rather than showing an invented figure.
AI_GATEWAY_INPUT_USD_PER_MTOK=""
AI_GATEWAY_OUTPUT_USD_PER_MTOK=""

# ---------------------------------------------------------------------------
# AI providers and metering (phase 27)
# ---------------------------------------------------------------------------
# ChainGPT bills one credit per request and reports no token counts, so its meter unit is
# a request. The model defaults to general_assistant; the base URL is only overridden in
# development (a stand-in), and outside development only an https override is honoured.
CHAINGPT_API_KEY=""
CHAINGPT_MODEL="general_assistant"
CHAINGPT_API_BASE_URL=""
# Dollars per request, for the meter. Optional: unset means the cost is reported as
# unpriced, never as zero.
CHAINGPT_USD_PER_REQUEST=""

# Tavily's search and extract are keyless at this tier, so the cost model defaults to
# zero rather than to unknown. Set this only if the deployment moves to a paid plan.
TAVILY_USD_PER_REQUEST=""

# SandBase puts 2,000+ third-party data APIs and models behind one key and one balance. Only
# one pinned entry is called from this build — `sandbase_twitter_web_search_timeline`, a
# pass-through to public Twitter/X keyword search that `sandbase inspect` reports at
# `base_price: 0` — and the assistant's `search_social_posts` tool is the only caller. The
# admin switch "SandBase data" in Access & Integrations must also be on. Unset means the tool
# refuses by name rather than the assistant estimating what the posts said. Create a key at
# https://www.sandbase.ai/console/keys; it belongs in the host's secret store, never here.
SANDBASE_API_KEY=""

# A local stand-in for the AI Gateway's chat endpoint, used only in development mode so
# the streaming path can be exercised without a provider account. Outside development
# only an https URL is honoured.
AI_GATEWAY_CHAT_URL=""

# ---------------------------------------------------------------------------
# Alchemy RPC
# ---------------------------------------------------------------------------
# The key is account-wide: ALCHEMY_API_KEY alone works on every network, and
# ALCHEMY_<NETWORK>_RPC_URL wins when it is set. Every variable named that way is
# discovered at runtime, so adding a network is a value change, not a code change.
# Unsetting the per-network variable on one scope silently removes RPC there.
#
# Real values live in `pass` (ai/alchemy-api-key) locally and in the host's
# per-environment secret store. This file must never hold one.

ALCHEMY_API_KEY=""
# Legacy shared-key name, still accepted as a fallback.
ALCHEMY_ETHEREUM_MAINNET_API_KEY=""
# A per-network key also declares the network: ALCHEMY_<NETWORK>_API_KEY is
# discovered exactly like the URL form, but it can only resolve through a known
# Alchemy host, so the per-network RPC URL above is the form to prefer.

# Dashboard identifier for the app; not a secret and not read by the application.
ALCHEMY_APP_ID=""

ALCHEMY_ETHEREUM_MAINNET_RPC_URL="https://eth-mainnet.g.alchemy.com/v2/<ALCHEMY_KEY>"
ALCHEMY_ETHEREUM_SEPOLIA_RPC_URL="https://eth-sepolia.g.alchemy.com/v2/<ALCHEMY_KEY>"
ALCHEMY_BASE_MAINNET_RPC_URL="https://base-mainnet.g.alchemy.com/v2/<ALCHEMY_KEY>"
ALCHEMY_BASE_SEPOLIA_RPC_URL="https://base-sepolia.g.alchemy.com/v2/<ALCHEMY_KEY>"
ALCHEMY_ARB_MAINNET_RPC_URL="https://arb-mainnet.g.alchemy.com/v2/<ALCHEMY_KEY>"
ALCHEMY_ARB_SEPOLIA_RPC_URL="https://arb-sepolia.g.alchemy.com/v2/<ALCHEMY_KEY>"
ALCHEMY_POLYGON_MAINNET_RPC_URL="https://polygon-mainnet.g.alchemy.com/v2/<ALCHEMY_KEY>"
ALCHEMY_OPT_MAINNET_RPC_URL="https://opt-mainnet.g.alchemy.com/v2/<ALCHEMY_KEY>"
ALCHEMY_SOLANA_MAINNET_RPC_URL="https://solana-mainnet.g.alchemy.com/v2/<ALCHEMY_KEY>"
# ... 157 networks total; the complete list is in /home/chris/env/alchemy.env

# ---------------------------------------------------------------------------
# Deposits
# ---------------------------------------------------------------------------
# Deposit addresses are *derived*, never generated: this seed and the account's
# own id are the whole input (BIP-44 `m/44'/60'/0'/0/<index>`, the index being the
# first four bytes of keccak256("<userId>:<network>")). Two consequences worth
# knowing before setting it:
#
#   * Changing it changes every address. Money already sent to the old ones still
#     arrives on chain and still gets recorded — but as UNMATCHED, because the
#     address is no longer one this deployment issued. Treat it as permanent.
#   * Any wallet holding funds on this deployment needs this to recover them, so it
#     belongs in the same secret store as the session secret, not in a file.
# Generate one with: node -e "console.log(require('viem/accounts').generateMnemonic())"
DEPOSIT_ADDRESS_MNEMONIC=""

# Which networks accept deposits, as registry slugs. Unset means the six mainnets
# whose deposit token this project already knows: ethereum-mainnet, base-mainnet,
# arb-mainnet, opt-mainnet, polygon-mainnet, bnb-mainnet.
#
# To accept on every network this build knows, list them all (the testnets are the
# QA surface and should not be enabled in production):
#   ethereum-mainnet,base-mainnet,arb-mainnet,opt-mainnet,polygon-mainnet,bnb-mainnet,
#   ethereum-sepolia,base-sepolia,arb-sepolia,polygon-amoy
#
# A slug that is not in the registry is reported by name rather than silently
# dropped. Adding an EVM chain the registry does not list is a registry entry
# (chain id, Alchemy slug, token contract, decimals), not an environment change.
#
# Any token is accepted. The watcher records every ERC-20/BEP-20 transfer to an issued
# address; one in a token this network does not configure is recorded as
# AWAITING_VALUATION and appears on /admin/data, where the owner credits it at a USDT
# value. Only the configured token is priced and credited automatically, because only
# that price is one the code can prove.
DEPOSIT_ENABLED_NETWORKS=""

# Minutes between deposit watcher runs. Defaults to 5. The watcher is also run on
# demand by the deposit panel's check button and by POST /api/cron/all, so a long
# interval costs latency, never correctness.
DEPOSIT_WATCH_INTERVAL_MINUTES=""

# How many blocks one run reads per network before leaving the rest for the next
# run, and how far back a network with no cursor starts (defaults to 250).
DEPOSIT_WATCH_BLOCKS=""

# "1" also records transfers addressed to *other* addresses in the scanned window
# (state UNMATCHED). It is the only way an owner sees money sent to an address this
# deployment never issued, and it reads every Transfer log on the chain, so it is
# off unless asked for.
DEPOSIT_SCAN_UNFILTERED=""

# Per-network overrides. <SLUG> is the network slug uppercased with dashes as
# underscores: ethereum-mainnet -> DEPOSIT_CONFIRMATIONS_ETHEREUM_MAINNET.
# Confirmations must be a whole number of at least 1; the minimum amount is the
# dust guard, and a transfer below it is recorded and never credited.
DEPOSIT_CONFIRMATIONS_ETHEREUM_MAINNET=""
DEPOSIT_MIN_AMOUNT_ETHEREUM_MAINNET=""

# The token expected on a network, required only where no official deployment is
# known — the testnets. Every network the registry already knows a contract for
# (mainnet USDT, Base's bridged USDT, USDT0 on Arbitrum and Polygon, Binance-Peg
# BSC-USD) works without these. Point them at a real contract: a transfer of the
# wrong token is recorded as TOKEN NOT ENABLED and never credited, and a network
# whose token is only half-configured is reported as such rather than watched with
# a guess.
DEPOSIT_TOKEN_ADDRESS_ETHEREUM_SEPOLIA=""
DEPOSIT_TOKEN_DECIMALS_ETHEREUM_SEPOLIA=""
DEPOSIT_TOKEN_SYMBOL_ETHEREUM_SEPOLIA=""

# ---------------------------------------------------------------------------
# Withdrawals
# ---------------------------------------------------------------------------
# The seed the *sending* wallet derives from (BIP-44 `m/44'/60'/0'/0/<index>`), the
# counterpart to DEPOSIT_ADDRESS_MNEMONIC. Unset means nothing can be signed: the
# withdrawal panel renders, says this variable by name, and refuses every request
# rather than pretending. It is a hot wallet — the balance on it is the balance
# that can be sent — so it belongs in the secret store beside the session secret.
# Generate one with: node -e "console.log(require('viem/accounts').generateMnemonic())"
WITHDRAWAL_HOT_WALLET_MNEMONIC=""

# Which account of that seed sends. Defaults to 0. Changing it changes the sending
# address, and with it the nonce sequence every in-flight withdrawal was signed with.
WITHDRAWAL_HOT_WALLET_INDEX=""

# A fallback only, since phase 16: the fee table saved on /admin/fees is the source of
# every price the deployment charges, and once a version exists it replaces this value
# for every asset. This name is read only when the table cannot be read at all, which
# leaves the deployment on its own values rather than inventing a price. In whole units
# of the asset: WITHDRAWAL_FEE_USDT=1 takes 1 USDT. Defaults to 0.
WITHDRAWAL_FEE_USDT=""

# The *fallback* for how long a first withdrawal to an address this account has never
# used is held before it is queued, used only until the owner saves a window on
# /admin/access — a stored setting always wins, and the panel says which of the two is
# in force. Defaults to 60 minutes when neither is set. This is the *only* hold in front
# of an owner's own withdrawal, its length and its reason are on screen, and 0 holds
# nothing at all.
WITHDRAWAL_NEW_ADDRESS_WINDOW_MINUTES=""

# How long an unexecuted request may wait before it expires and the amount goes back
# to the balance, in minutes. Defaults to 10080 (seven days). Between the window
# passing and this expiring the amount stays reserved, so a request cannot be spent
# twice.
WITHDRAWAL_REQUEST_EXPIRY_MINUTES=""

# How long a broadcast-but-unconfirmed withdrawal must be silent before the panel
# offers a cancellation attempt. Defaults to 60 minutes. A cancellation of something
# already on chain is an *attempt* — a same-nonce replacement — so the panel reports
# which kind it was rather than promising the money came back.
WITHDRAWAL_CANCEL_AFTER_MINUTES=""

# Minutes between passes of the withdrawal processor. Defaults to 2. The processor is
# also run on demand by the panel's check button and by POST /api/cron/all, so a long
# interval costs latency, never correctness.
WITHDRAWAL_PROCESS_INTERVAL_MINUTES=""

# `onchain` or `simulated`. Unset means simulated under `next dev` and on chain
# everywhere else. A simulated broadcast signs the real transfer and mines it after a
# fixed number of polls without touching a chain, and is refused outside development:
# a confirmation nobody's chain produced must never be mistaken for money.
WITHDRAWAL_BROADCAST_MODE=""

# Development only, and ignored everywhere else: make the next simulated send fail a
# declared way so every failure state is reachable by hand — rpc-unavailable,
# nonce-conflict or reverted. Unset means the simulation succeeds.
WITHDRAWAL_SIMULATE_FAILURE=""

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------

# Minimum level for structured server log lines: debug, info, warn or error.
# Unset means debug under `next dev` (every outbound provider call is logged)
# and info everywhere else (only what went wrong). A request id is attached to
# every request and echoed in the `x-request-id` response header whatever this
# is set to, and provider call records are kept in all environments.
LOG_LEVEL=""

# ---------------------------------------------------------------------------
# Managed by the platform, listed so nothing here is a surprise
# ---------------------------------------------------------------------------

# Set by Next.js itself; `development` is the only value that unlocks the local
# database banner, the seeded paper session and raw error text.
NODE_ENV=""

# Set by Next.js per bundle ("nodejs" or "edge"). src/instrumentation.ts reads it
# to keep the Node-only paper seed out of the edge build. Never set it by hand.
NEXT_RUNTIME=""

# Injected by the hosting platform at runtime. Never set this by hand.
VERCEL_OIDC_TOKEN=""

# Not read by the application today (kept so existing host configuration is
# documented rather than silently dropped).
NEXT_PUBLIC_APP_URL="http://localhost:3000"
